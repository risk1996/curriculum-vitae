---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src?: string | ImageMetadata;
  alt?: string;
}

const { src, alt = "証明写真" } = Astro.props;
const size = "h-[40mm] w-[30mm]";
---

{typeof src === "string" ? (
  <img src={src} alt={alt} class:list={[size, "object-cover"]} />
) : src ? (
  <Image
    src={src}
    alt={alt}
    width={360}
    height={480}
    fit="cover"
    loading="eager"
    class:list={[size, "object-cover"]}
  />
) : (
  <div
    class:list={[
      size,
      "flex items-center justify-center border border-dashed px-2 text-center text-[9pt]",
    ]}
  >
    写真を貼る位置
  </div>
)}
