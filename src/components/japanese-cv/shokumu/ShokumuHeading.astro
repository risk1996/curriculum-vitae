---
import RirekiDate from "~/components/japanese-cv/rireki/RirekiDate.astro";

interface Props {
  name: string;
  asOf?: Date;
}

const { name, asOf } = Astro.props;
---

<header class="mb-1 pr-[3pt]">
  <h1 class="mb-[6pt] pt-[2pt] pl-2 text-center text-[14pt] leading-[23pt] tracking-[0.45em]">
    職務経歴書
  </h1>
  <div class="text-right text-[9pt] leading-[15.5pt]">
    <p>
      <RirekiDate date={asOf} compact />
    </p>
    <p class="underline underline-offset-2">氏名 {name}</p>
  </div>
</header>
