---
interface Project {
  period: string;
  title: string;
  overview?: string;
  responsibilities?: readonly string[];
  achievements?: readonly string[];
  environment?: readonly { label: string; value: string }[];
  team?: string;
  role?: string;
}

interface Props {
  period: string;
  company: string;
  business?: string;
  staff?: string;
  employment?: string;
  projects: readonly Project[];
}

const { period, company, business, staff, employment, projects } = Astro.props;
---

<section class="text-[8.6pt] leading-[11.65pt]">
  <h3 class="border border-black bg-[#f0f0f0] px-[5pt] py-[5pt] text-[11pt] leading-[13pt] print:break-after-avoid">
    <span class="mr-[12pt]">{period}</span>
    {company}
  </h3>
  <table
    aria-label={company}
    class="w-full table-fixed border-collapse border-[0.5pt] border-black/50 [&_td]:border-[0.5pt] [&_td]:border-black/50 [&_th]:border-[0.5pt] [&_th]:border-black/50"
  >
    <colgroup>
      <col class="w-[70.2%]" />
      <col class="w-[15.8%]" />
      <col class="w-[14%]" />
    </colgroup>
    {(business || staff || employment) && (
      <tbody>
        <tr class="print:break-after-avoid">
          <td colspan="2" class="px-[5pt] py-[3pt]">
            {business && <p class="text-justify">事業内容： {business}</p>}
            {staff && <p>従業員数： {staff}</p>}
          </td>
          <td class="px-[5pt] py-[3pt] whitespace-pre-line">{employment}</td>
        </tr>
      </tbody>
    )}
    {projects.map((project) => (
      <tbody class="print:break-inside-avoid">
        <tr>
          <th
            colspan="3"
            scope="rowgroup"
            class="bg-[#f0f0f0] px-[5pt] py-[2pt] text-left text-[10pt] leading-[13pt] font-normal"
          >
            {project.period}
            {"　／ "}
            {project.title}
          </th>
        </tr>
        <tr class="align-top">
          <td class="space-y-[11.65pt] py-px pr-1 pl-[5pt] text-justify">
            {project.overview && (
              <div>
                <h4>【プロジェクト概要】</h4>
                <p>{project.overview}</p>
              </div>
            )}
            {project.responsibilities?.length ? (
              <div>
                <h4>【業務内容】</h4>
                <ul>
                  {project.responsibilities.map((item) => (
                    <li>・{item}</li>
                  ))}
                </ul>
              </div>
            ) : null}
            {project.achievements?.length ? (
              <div>
                <h4>【実績・取り組み】</h4>
                <ul>
                  {project.achievements.map((item) => (
                    <li>・{item}</li>
                  ))}
                </ul>
              </div>
            ) : null}
          </td>
          <td class="px-[5pt] py-px">
            <dl class="space-y-[11.65pt] wrap-anywhere">
              {project.environment?.map(({ label, value }) => (
                <div>
                  <dt class="-ml-[0.5em]">【{label}】</dt>
                  <dd class="whitespace-pre-line">{value}</dd>
                </div>
              ))}
            </dl>
          </td>
          <td class="space-y-[11.65pt] py-px pr-0.5 pl-[5pt] tracking-tight wrap-anywhere whitespace-pre-line">
            {project.team && <p>{project.team}</p>}
            {project.role && <p>{project.role}</p>}
          </td>
        </tr>
      </tbody>
    ))}
  </table>
</section>
