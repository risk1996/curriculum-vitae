---
import { twMerge } from "tailwind-merge";

import PortraitImage from "#/portrait.jpg";
import { Image } from "astro:assets";
import { blurhash } from "~/helpers/image";

interface Props {
  class?: string;
}
---

<Image
  src={PortraitImage}
  alt="Portrait picture of William Darian"
  height={740}
  width={740}
  class={twMerge("grow-0", Astro.props.class)}
  style={blurhash("URMQ9Uof~pWB^+WBRjofI;ofM{jZ^*ayRjj[")}
  loading="eager"
/>
