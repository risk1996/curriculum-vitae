{
  "cSpell.words": [
    "astrojs",
    "biomejs",
    "blurhash",
    "faceshot",
    "flazz",
    "fontsource",
    "iconify",
    "prelogin",
    "segoe",
    "subaccount",
    "sutedjo",
    "tabler",
    "treehouse",
    "tsconfigs",
    "unpic",
    "valibot"
  ],
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit",
    "source.fixAll.biome": "explicit"
  },
  "editor.defaultFormatter": "biomejs.biome",
  "discord.enabled": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.classpath": true,
    "**/.factorypath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/node_modules": false
  }
}
